# Ambiente local e segredos
.env
.env.*
!.env.example
!.env.*.example
/secrets/
/certificates/

# Dependências e artefatos de build
/vendor/
/node_modules/
/public/build/
/public/hot
/artifacts/
/backups/
/dist/

# Dados operacionais: arquivos já rastreados do legado não são removidos
/database.db
/database/*.db
/database/*.sqlite
/database/*.sqlite3
/uploads/

# Estado local do Laravel; preservar marcadores de diretório futuros
/storage/*.key
/storage/app/private/*
!/storage/app/private/.gitignore
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php

# Cache de testes
/.phpunit.cache/
/.phpunit.result.cache
/coverage/

# Configuração pessoal de IDE e arquivos do sistema
/.idea/
/.vscode/*.local.json
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
