<?xml version="1.0" encoding="utf-8"?>
<!--
  REDE DE SEGURANÇA (IIS). O correto é apontar o site para a pasta public/.
  Se o site apontar para esta pasta, o IIS passa a recusar as pastas internas
  (o site em si não funciona até o docroot ser corrigido: falha fechada).
  Este arquivo usa só recursos nativos do IIS (sem URL Rewrite).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="src" />
          <add segment="config" />
          <add segment="storage" />
          <add segment="bin" />
          <add segment="docs" />
          <add segment="_backup_original" />
          <add segment="graft" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".md" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
