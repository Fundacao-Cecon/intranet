# Texto e fins de linha para documentação e desenvolvimento Linux
* text=auto
*.md text eol=lf
*.php text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile* text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Arquivos legados binários
*.db binary
*.sqlite binary
*.sqlite3 binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.tar binary
*.gz binary
